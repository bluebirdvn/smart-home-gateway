[Unit]
Description=Communication between raspi and esp32 through uart
Requires=local-database.service
After=local-database.service network.target
PartOf=local-database.service

[Service]
Type=simple
Environment=GATEWAY_CONFIG_PATH=/etc/gateway/config.json
Environment=UART_PORT_DAEMON=/dev/ttyAMA0
ExecStart=/usr/bin/gateway-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target